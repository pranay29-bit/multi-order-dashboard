# Choose "firebase" only on a private Streamlit server. GitHub Pages cannot use this.
KOTAK_CREDENTIAL_STORE=local
KOTAK_CONSUMER_KEY=
KOTAK_CONSUMER_SECRET=
KOTAK_ENV=prod
# Required for Firebase-backed credential storage (set these as deployment secrets).
# Generate CREDENTIAL_VAULT_KEY with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIREBASE_SERVICE_ACCOUNT_JSON=
CREDENTIAL_VAULT_KEY=
VAULT_ACCESS_PASSWORD=
